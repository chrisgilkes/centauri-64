10 REM ISSUE02 AUDIT — KEY / KEYPRESSED
20 REM KEY("NAME") = 1 WHILE HELD
30 REM KEYPRESSED("NAME") = 1 ON PRESS EDGE
40 REM NAMES: LEFT RIGHT UP DOWN SPACE ENTER ESC 0-9 A-Z
50 MODE 1
60 PAPER 0
70 CLS
80 PRINTAT 16,16,"HOLD ARROWS / SPACE"
90 PRINTAT 16,32,"PRESS ENTER TO END"
100 X=300
110 Y=220
120 CLS
130 PRINTAT 16,16,"X="+X+" Y="+Y
140 IF KEY("LEFT") THEN X=X-4
150 IF KEY("RIGHT") THEN X=X+4
160 IF KEY("UP") THEN Y=Y-4
170 IF KEY("DOWN") THEN Y=Y+4
180 IF KEY("SPACE") THEN C=7
190 IF KEY("SPACE")=0 THEN C=15
200 RECT X,Y,24,24,C,FILL
210 IF KEYPRESSED("ENTER") THEN GOTO 240
220 YIELD
230 GOTO 120
240 CLS
250 PRINT "DONE"
260 WAIT 1000
270 END
