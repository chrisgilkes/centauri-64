10 REM LUNAR RESCUE PROTOTYPE — ISSUE02 AUDIT
20 REM FRAME MODEL: RETAINED PRIMITIVES + CLS EACH FRAME
30 REM CRITICAL: CLS THEN GOSUB AUTO-YIELDS (BLANK FRAME).
40 REM SAFE PATTERN (SAME AS PONG): GOSUB THAT STARTS WITH CLS,
50 REM THEN ONLY DRAW/IF/PRINTAT, THEN RETURN — THEN PHYSICS — YIELD.
60 MODE 1
70 PAPER 0
80 GOSUB 9000
90 GOTO 1000
100 REM ---- DRAW FRAME (MUST BEGIN WITH CLS) ----
110 CLS
120 RECT 0,GROUND,640,480-GROUND,12,FILL
130 RECT PADX,GROUND-6,PADW,6,7,FILL
140 LINE 0,GROUND,639,GROUND,15
150 RECT X,Y,20,14,15,FILL
160 RECT X+6,Y-6,8,6,15,FILL
170 IF THRUST=0 THEN GOTO 200
180 LINE X+4,Y+14,X+10,Y+22,2
190 LINE X+16,Y+14,X+10,Y+22,2
200 PRINTAT 8,8,"FUEL "+FUEL
210 PRINTAT 200,8,"VY "+VY
220 RETURN
300 REM ---- INPUT ----
310 THRUST=0
320 IF KEY("LEFT") THEN VX=VX-1
330 IF KEY("RIGHT") THEN VX=VX+1
340 IF KEY("UP")=0 THEN RETURN
350 IF FUEL<=0 THEN RETURN
360 THRUST=1
370 VY=VY-2
380 FUEL=FUEL-1
390 RETURN
400 REM ---- PHYSICS ----
410 IF VX>4 THEN VX=4
420 IF VX<-4 THEN VX=-4
430 VY=VY+1
440 X=X+VX
450 Y=Y+VY
460 IF X<0 THEN X=0
470 IF X>620 THEN X=620
480 IF Y<0 THEN Y=0
490 RETURN
500 REM ---- LAND / CRASH ----
510 IF Y+14<GROUND THEN RETURN
520 Y=GROUND-14
530 IF X<PADX THEN GOTO 700
540 IF X+20>PADX+PADW THEN GOTO 700
550 IF VY>8 THEN GOTO 700
560 GOTO 600
600 REM SAFE
610 CLS
620 PRINTAT 220,200,"SAFE LANDING"
630 PRINTAT 200,230,"PRESS SPACE"
640 IF KEYPRESSED("SPACE")=0 THEN GOTO 640
650 GOSUB 9000
660 RETURN
700 REM CRASH
710 CLS
720 PRINTAT 240,200,"CRASHED"
730 PRINTAT 200,230,"PRESS SPACE"
740 IF KEYPRESSED("SPACE")=0 THEN GOTO 740
750 GOSUB 9000
760 RETURN
1000 REM ---- MAIN LOOP ----
1010 REM INPUT/PHYSICS FIRST, THEN ONE DRAW BURST, THEN YIELD
1020 GOSUB 300
1030 GOSUB 400
1040 GOSUB 100
1050 GOSUB 500
1060 YIELD
1070 GOTO 1000
9000 REM ---- RESET ROUND ----
9010 X=300
9020 Y=30
9030 VX=0
9040 VY=0
9050 FUEL=120
9060 GROUND=420
9070 PADX=260
9080 PADW=100
9090 THRUST=0
9100 RETURN
