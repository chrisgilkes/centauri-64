10 CLS
20 PRINT "DARK CAVE ADVENTURE"
30 PRINT "YOU STAND IN A DAMP CAVE."
40 PRINT "EXITS: NORTH, EAST"
50 INPUT "WHAT NOW";C$
60 IF C$="NORTH" THEN GOTO 100
70 IF C$="EAST" THEN GOTO 200
80 PRINT "YOU CANNOT GO THAT WAY."
90 GOTO 50
100 PRINT "A GLOWING KEY LIES HERE."
110 INPUT "TAKE KEY";A$
120 IF A$="YES" THEN K=1
130 GOTO 50
200 IF K=1 THEN GOTO 300
210 PRINT "A LOCKED DOOR BLOCKS THE WAY."
220 GOTO 50
300 PRINT "YOU ESCAPE INTO DAYLIGHT!"
310 PRINT "THE END."
320 END
