10 REM LUNAR RESCUE — CLEAN FRAME LOOP (ISSUE02)
20 REM UPDATE → CLS → DRAW (GOSUBS OK) → YIELD → REPEAT
30 REM LEFT/RIGHT STRAFE  UP THRUST  LAND SOFTLY ON THE PAD
40 MODE 1
50 PAPER 0
60 GOSUB 9000
70 GOTO 1000
100 REM ---- DRAW TERRAIN ----
110 RECT 0,GROUND,640,480-GROUND,12,FILL
120 RECT PADX,GROUND-6,PADW,6,7,FILL
130 LINE 0,GROUND,639,GROUND,15
140 RETURN
200 REM ---- DRAW LANDER ----
210 RECT X,Y,20,14,15,FILL
220 RECT X+6,Y-6,8,6,15,FILL
230 IF THRUST=0 THEN GOTO 260
240 LINE X+4,Y+14,X+10,Y+22,2
250 LINE X+16,Y+14,X+10,Y+22,2
260 RETURN
270 REM ---- DRAW HUD ----
280 PRINTAT 8,8,"FUEL "+FUEL
290 PRINTAT 200,8,"VY "+VY
300 RETURN
400 REM ---- INPUT ----
410 THRUST=0
420 IF KEY("LEFT") THEN VX=VX-1
430 IF KEY("RIGHT") THEN VX=VX+1
440 IF KEY("UP")=0 THEN RETURN
450 IF FUEL<=0 THEN RETURN
460 THRUST=1
470 VY=VY-2
480 FUEL=FUEL-1
490 RETURN
500 REM ---- PHYSICS ----
510 IF VX>4 THEN VX=4
520 IF VX<-4 THEN VX=-4
530 VY=VY+1
540 X=X+VX
550 Y=Y+VY
560 IF X<0 THEN X=0
570 IF X>620 THEN X=620
580 IF Y<0 THEN Y=0
590 RETURN
600 REM ---- LAND / CRASH ----
610 IF Y+14<GROUND THEN RETURN
620 Y=GROUND-14
630 IF X<PADX THEN GOTO 800
640 IF X+20>PADX+PADW THEN GOTO 800
650 IF VY>8 THEN GOTO 800
660 GOTO 700
700 REM SAFE
710 CLS
720 PRINTAT 220,200,"SAFE LANDING"
730 PRINTAT 200,230,"PRESS SPACE"
740 YIELD
750 IF KEYPRESSED("SPACE")=0 THEN GOTO 740
760 GOSUB 9000
770 RETURN
800 REM CRASH
810 CLS
820 PRINTAT 240,200,"CRASHED"
830 PRINTAT 200,230,"PRESS SPACE"
840 YIELD
850 IF KEYPRESSED("SPACE")=0 THEN GOTO 840
860 GOSUB 9000
870 RETURN
1000 REM ---- MAIN LOOP ----
1010 GOSUB 400
1020 GOSUB 500
1030 CLS
1040 GOSUB 100
1050 GOSUB 200
1060 GOSUB 270
1070 YIELD
1080 GOSUB 600
1090 GOTO 1000
9000 REM ---- RESET ROUND ----
9010 X=300
9020 Y=30
9030 VX=0
9040 VY=0
9050 FUEL=120
9060 GROUND=420
9070 PADX=260
9080 PADW=100
9090 THRUST=0
9100 RETURN
